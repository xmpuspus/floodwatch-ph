---
// MapView -- Sentinel-1 flood extent time slider for Typhoon Carina 2024.
// Loads flood polygons filtered by slider date, hazard-gap province
// layer, recurrence-prone overlay, and a province exposure card.
//
// The slider is server-rendered from events.json as a fallback, but the client
// rebuilds it from the distinct sorted dates in flood_carina_2024.geojson
// _meta.dates at runtime. Dates are never hardcoded in the client.
import events from "../data/events.json";

const carina = (events as any).carina_2024;
const sliderDates: string[] = carina.event_dates;
---

<section class="max-w-6xl mx-auto px-6 mb-3">
  <details class="border-l-2 border-accent-flood bg-paper-alt">
    <summary class="cursor-pointer px-4 py-2.5 text-sm font-medium text-ink-900">How to read this map</summary>
    <div class="px-4 pb-4 pt-1 text-sm text-ink-700 leading-relaxed space-y-2 max-w-prose">
      <p>
        The time slider steps through the Sentinel-1 SAR acquisition dates bracketing Super Typhoon Carina (Gaemi) in July-August 2024 over Metro Manila, Bulacan, and Pampanga. Each frame shows the observed open-water extent at that date, after permanent rivers and lakes are subtracted. The flood polygons grow from the pre-event date through peak inundation and into recession.
      </p>
      <p>
        <strong>Color encoding (province, FAO GAUL level-2):</strong>
        <span class="inline-block w-3 h-3 align-middle rounded-sm" style="background:#d1495b"></span> red = modeled-prone but under-observed in the historical record;
        <span class="inline-block w-3 h-3 align-middle rounded-sm" style="background:#5b7fa6"></span> blue = charted in the historical record;
        <span class="inline-block w-3 h-3 align-middle rounded-sm" style="background:#8aa0bc"></span> steel = monitored;
        <span class="inline-block w-3 h-3 align-middle rounded-sm" style="background:#aab4c2"></span> gray = low.
        Click any province to see exposed population, built-up area, observed historical events, and peak flood share.
      </p>
      <p>Full methodology: <a href="/methodology" class="text-accent-steel no-underline">how the flood extents were computed</a>.</p>
    </div>
  </details>
</section>

<!-- Time slider controls -->
<section class="max-w-6xl mx-auto px-6 mb-3">
  <div class="bg-paper border border-ink-300/30 p-4">
    <div class="flex flex-wrap items-center gap-4 mb-3">
      <div>
        <p class="text-[10px] uppercase tracking-wider text-ink-500 font-mono mb-1">acquisition date</p>
        <p id="slider-date-display" class="font-mono tabular-nums text-xl text-ink-900">--</p>
      </div>
      <div class="flex-1 min-w-[200px]">
        <input
          id="date-slider"
          type="range"
          min="0"
          max={sliderDates.length - 1}
          value="0"
          step="1"
          class="w-full accent-accent-flood"
          aria-label="Select flood observation date"
        />
        <div id="slider-ticks" class="flex justify-between text-[10px] text-ink-500 font-mono mt-1">
          {sliderDates.map((d) => <span>{d}</span>)}
        </div>
      </div>
      <div class="flex gap-2">
        <button id="play-btn" class="inline-flex items-center px-3 py-1.5 text-xs font-mono uppercase tracking-wider border border-ink-900 text-ink-900 hover:bg-ink-900 hover:text-white">
          play
        </button>
      </div>
    </div>

    <!-- Layer toggles -->
    <div class="flex flex-wrap gap-4 text-xs border-t border-ink-300/20 pt-3">
      <label class="flex items-center gap-1.5 cursor-pointer">
        <input id="toggle-flood" type="checkbox" checked class="accent-accent-flood" />
        <span class="text-ink-700">Flood extent</span>
      </label>
      <label class="flex items-center gap-1.5 cursor-pointer">
        <input id="toggle-gap" type="checkbox" checked class="accent-accent-gap" />
        <span class="text-ink-700">Hazard gap layer</span>
      </label>
      <label class="flex items-center gap-1.5 cursor-pointer">
        <input id="toggle-recurrence" type="checkbox" class="accent-ink-500" />
        <span class="text-ink-700">Recurrence-prone overlay</span>
      </label>
    </div>
  </div>
</section>

<div id="map-root" class="grid md:grid-cols-[1fr_360px] gap-4 px-6 max-w-6xl mx-auto">
  <div class="relative">
    <div id="map" class="w-full h-[640px] rounded-md border border-ink-300/30 bg-ink-300/10">
      <div id="map-loading" class="absolute inset-0 flex items-center justify-center text-sm text-ink-500">
        Loading map data...
      </div>
    </div>

    <!-- Legend -->
    <div class="absolute bottom-3 left-3 bg-white/95 border border-ink-300/40 rounded p-3 text-xs shadow-sm">
      <div class="text-ink-500 uppercase tracking-wider text-[10px] mb-1.5 font-mono">flood extent</div>
      <div class="grid grid-cols-[auto_1fr] items-center gap-x-2 gap-y-0.5 text-[10px] text-ink-700 mb-2">
        <span class="inline-block w-3 h-3 rounded-sm opacity-60" style="background:#1391d4"></span><span>observed open water (SAR)</span>
      </div>
      <div class="text-ink-500 uppercase tracking-wider text-[10px] mb-1 font-mono">hazard gap (province)</div>
      <div class="grid grid-cols-[auto_1fr] items-center gap-x-2 gap-y-0.5 text-[10px] text-ink-700">
        <span class="inline-block w-3 h-3 rounded-sm opacity-70" style="background:#d1495b"></span><span>modeled-prone, under-observed</span>
        <span class="inline-block w-3 h-3 rounded-sm opacity-70" style="background:#5b7fa6"></span><span>charted in historical record</span>
        <span class="inline-block w-3 h-3 rounded-sm opacity-70" style="background:#8aa0bc"></span><span>monitored</span>
        <span class="inline-block w-3 h-3 rounded-sm opacity-70" style="background:#aab4c2"></span><span>low</span>
      </div>
      <div id="legend-source" class="text-[10px] text-ink-500 mt-1.5 font-mono">FloodWatch.PH &middot; Sentinel-1 SAR</div>
    </div>

    <div class="absolute bottom-1 right-2 bg-white/85 px-1.5 py-0.5 text-[9px] text-ink-500 rounded-sm border border-ink-300/30 leading-tight">
      &copy; OpenStreetMap contributors. SAR: Copernicus/Sentinel-1.
    </div>
  </div>

  <!-- Sidebar -->
  <aside id="side-panel" class="border border-ink-300/40 bg-white text-sm overflow-hidden">
    <div id="empty-state" class="p-5">
      <p class="text-xs uppercase tracking-wider text-ink-500 mb-2 font-mono">click any province</p>
      <p class="text-ink-700 leading-relaxed">
        Select a province on the map to see exposed population, built-up area, observed historical flood events, and peak flood share.
      </p>
      <div class="mt-5 pt-5 border-t border-ink-300/30">
        <p class="text-[10px] uppercase tracking-wider text-ink-500 font-mono mb-2">about this map</p>
        <p class="text-xs text-ink-700 leading-relaxed">
          Observed flood extent from Sentinel-1 C-band SAR for Super Typhoon Carina (Gaemi), July-August 2024. Permanent rivers and lakes removed via MERIT Hydro HAND + JRC Global Surface Water mask. Exposure and the modeled-vs-observed gap are aggregated to province (FAO GAUL level-2, ~82 Philippine provinces); city and barangay resolution is a v1.1 refinement.
        </p>
        <p class="text-[10px] text-ink-500 mt-3 leading-relaxed italic">
          Observed flood extent derived from public satellite data. Patterns may have legitimate explanations; figures warrant independent verification.
        </p>
      </div>
    </div>

    <div id="city-detail" class="hidden">
      <div class="px-5 pt-5 pb-4">
        <button id="brgy-back" class="text-[10px] uppercase tracking-wider text-ink-500 hover:text-ink-900 font-mono mb-2">&larr; back</button>
        <p class="text-xs uppercase tracking-wider text-ink-500 font-mono" id="brgy-location"></p>
        <h3 id="brgy-name" class="text-2xl font-semibold tracking-tight text-ink-900 leading-none mt-1 mb-4"></h3>
      </div>

      <div class="px-5 pb-4">
        <div class="grid grid-cols-2 gap-3 mb-4">
          <div class="border border-ink-300/30 p-3">
            <div class="text-[10px] uppercase tracking-wider text-ink-500 font-mono">population exposed</div>
            <div id="brgy-pop" class="font-mono tabular-nums text-3xl text-ink-900 mt-0.5">--</div>
            <div class="text-[10px] text-ink-500">WorldPop estimate</div>
          </div>
          <div class="border border-ink-300/30 p-3">
            <div class="text-[10px] uppercase tracking-wider text-ink-500 font-mono">built-up area</div>
            <div id="brgy-builtup" class="font-mono tabular-nums text-3xl text-ink-900 mt-0.5">--</div>
            <div class="text-[10px] text-ink-500">km&sup2; (Microsoft GlobalML)</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 mb-4">
          <div class="border border-ink-300/30 p-3">
            <div class="text-[10px] uppercase tracking-wider text-ink-500 font-mono">observed events</div>
            <div id="brgy-events" class="font-mono tabular-nums text-2xl text-ink-900 mt-0.5">--</div>
            <div class="text-[10px] text-ink-500">historical GFD record (2002-2017)</div>
          </div>
          <div class="border border-ink-300/30 p-3">
            <div class="text-[10px] uppercase tracking-wider text-ink-500 font-mono">peak flood share</div>
            <div id="brgy-flood-pct" class="font-mono tabular-nums text-2xl text-ink-900 mt-0.5">--</div>
            <div class="text-[10px] text-ink-500 mt-0.5">max area share (Carina 2024)</div>
          </div>
        </div>

        <div id="brgy-hazard-row" class="border border-ink-300/30 p-3">
          <div class="text-[10px] uppercase tracking-wider text-ink-500 font-mono mb-1">official hazard map overlay</div>
          <div id="brgy-hazard-status" class="text-sm font-medium"></div>
        </div>
      </div>

      <div class="px-5 py-3 border-t border-ink-300/30">
        <p class="text-[10px] text-ink-500 leading-relaxed italic">
          Observed flood extent derived from public satellite data. Patterns may have legitimate explanations; figures warrant independent verification.
        </p>
      </div>
    </div>
  </aside>
</div>

<script define:vars={{ sliderDates }} is:inline>
  window.__FLOODWATCH_DATES = sliderDates;
</script>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";

  // Server-rendered fallback dates. The real slider dates are read from the
  // flood GeoJSON _meta.dates at runtime in init(); this is only the
  // pre-hydration placeholder so the slider DOM is not empty.
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  let DATES: string[] = ((window as any).__FLOODWATCH_DATES as string[]) ?? [];
  const DATA_BASE = "/data";

  // ---- helpers --------------------------------------------------------

  function fmtInt(n: number): string {
    return n.toLocaleString();
  }

  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  async function safeFetch(url: string): Promise<any> {
    try {
      const r = await fetch(url);
      if (!r.ok) return null;
      return await r.json();
    } catch {
      return null;
    }
  }

  // Read distinct sorted acquisition dates. Prefer _meta.dates (the real
  // schema: list of {date, flood_area_km2, otsu_threshold_db, n_polygons}),
  // fall back to distinct feature.properties.date values. Never hardcoded.
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  function datesFromFlood(floodData: any): string[] {
    if (!floodData) return [];
    const out = new Set<string>();
    const metaDates = floodData?._meta?.dates;
    if (Array.isArray(metaDates)) {
      for (const d of metaDates) {
        const v = typeof d === "string" ? d : d?.date;
        if (typeof v === "string" && v) out.add(v);
      }
    }
    if (out.size === 0 && Array.isArray(floodData.features)) {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      for (const f of floodData.features as any[]) {
        const v = f?.properties?.date;
        if (typeof v === "string" && v) out.add(v);
      }
    }
    return Array.from(out).sort();
  }

  // Rebuild the slider DOM (range max + tick labels) for the real dates.
  function applyDatesToSlider(dates: string[]): void {
    const slider = document.getElementById("date-slider") as HTMLInputElement | null;
    if (slider) {
      slider.max = String(Math.max(0, dates.length - 1));
      slider.value = "0";
      slider.disabled = dates.length === 0;
    }
    const ticks = document.getElementById("slider-ticks");
    if (ticks) {
      ticks.innerHTML = "";
      for (const d of dates) {
        const s = document.createElement("span");
        s.textContent = d;
        ticks.appendChild(s);
      }
    }
  }

  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  function showCity(props: Record<string, any>, exposureUnits: Record<string, any> | null): void {
    const emptyState = document.getElementById("empty-state");
    const detail = document.getElementById("city-detail");
    emptyState?.classList.add("hidden");
    detail?.classList.remove("hidden");

    // The hazard_gap GeoJSON keeps a "city" key but its value is the province
    // name (from ADM2_NAME / FAO GAUL level-2). The "province" key holds the
    // region. Show the province name as the area name (not "City:") and the
    // region as the sublabel.
    const areaName =
      (props["city"] as string) || (props["name"] as string) || "Province";
    const region = (props["province"] as string) || "";

    const nameEl = document.getElementById("brgy-name");
    const locEl = document.getElementById("brgy-location");
    if (nameEl) nameEl.textContent = areaName;
    if (locEl) locEl.textContent = region ? `${region} · Province (FAO GAUL level-2)` : "Province · FAO GAUL level-2";

    // hazard_gap features carry the province NAME (props.city = ADM2_NAME),
    // but barangay_exposure.json units are keyed by ADM2_CODE. Join by name.
    let exp: Record<string, any> | null = null;
    if (exposureUnits) {
      const target = String(areaName).trim().toLowerCase();
      for (const u of Object.values(exposureUnits)) {
        const un = (u as any) && ((u as any).name ?? (u as any).city);
        if (un && String(un).trim().toLowerCase() === target) {
          exp = u as Record<string, any>;
          break;
        }
      }
    }

    const popEl = document.getElementById("brgy-pop");
    const builtEl = document.getElementById("brgy-builtup");
    const eventsEl = document.getElementById("brgy-events");
    const floodPctEl = document.getElementById("brgy-flood-pct");
    const hazardEl = document.getElementById("brgy-hazard-status");

    // observed_events / recurrence_score may live on the gap feature itself
    const observedEvents =
      (exp && exp["observed_events"]) ?? props["observed_events"] ?? null;

    if (popEl) {
      popEl.textContent = exp && exp["population"] != null ? fmtInt(exp["population"] as number) : "--";
    }
    if (builtEl) {
      builtEl.textContent =
        exp && exp["built_up_km2"] != null ? (exp["built_up_km2"] as number).toFixed(1) : "--";
    }
    if (eventsEl) {
      eventsEl.textContent = observedEvents != null ? fmtInt(observedEvents as number) : "--";
    }
    if (floodPctEl) {
      // peak_flood_pct is already a percentage (exposure.py: round(frac*100,2))
      const pf = exp ? exp["peak_flood_pct"] : null;
      floodPctEl.textContent =
        pf != null ? `${(pf as number).toFixed(2)}%` : "--";
    }
    if (hazardEl) {
      // v1.0 ships no official-hazard-map comparison (on_official_hazard_map
      // is null). The official UP NOAH/PAGASA/MGB overlay is a v1.1 refinement.
      const onMap = exp ? exp["on_official_hazard_map"] : null;
      if (onMap === true || onMap === false) {
        hazardEl.textContent = onMap ? "On official hazard map" : "Not on official hazard map";
        hazardEl.className = `text-sm font-medium ${onMap ? "text-accent-steel" : "text-accent-coral-dark"}`;
      } else {
        hazardEl.textContent = "Not compared in v1.0 - official hazard overlay is a v1.1 refinement";
        hazardEl.className = "text-sm text-ink-500";
      }
    }
  }

  // ---- init -----------------------------------------------------------

  async function init(): Promise<void> {
    const loadingEl = document.getElementById("map-loading");

    const map = new maplibregl.Map({
      container: "map",
      style: {
        version: 8,
        sources: {
          osm: {
            type: "raster",
            tiles: [
              "https://a.tile.openstreetmap.org/{z}/{x}/{y}.png",
              "https://b.tile.openstreetmap.org/{z}/{x}/{y}.png",
              "https://c.tile.openstreetmap.org/{z}/{x}/{y}.png",
            ],
            tileSize: 256,
            attribution: "&copy; OpenStreetMap contributors",
          },
        },
        layers: [{ id: "osm", type: "raster", source: "osm" }],
      },
      center: [120.95, 14.85] as [number, number],
      zoom: 9,
    });

    // Expose the Carina map handle SYNCHRONOUSLY (not inside on-load). This
    // map starts in a display:none tab panel, so MapLibre will not fire its
    // load event until the panel is shown and the map is resized. The tab
    // switcher needs this handle to call .resize() and trigger that load.
    (window as unknown as Record<string, unknown>)["__fwCarinaMap"] = map;

    map.addControl(new maplibregl.NavigationControl(), "top-right");

    // Load all data in parallel, degrade gracefully on missing files
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    // recurrence_prone.geojson (~1.5 MB) is OFF by default. Don't pull it on
    // load; fetch lazily on the first "Recurrence-prone overlay" toggle.
    const [floodData, hazardData, exposureData]: [any, any, any] = await Promise.all([
      safeFetch(`${DATA_BASE}/flood_carina_2024.geojson`),
      safeFetch(`${DATA_BASE}/hazard_gap.geojson`),
      safeFetch(`${DATA_BASE}/barangay_exposure.json`),
    ]);

    if (loadingEl) loadingEl.style.display = "none";

    // Read the real acquisition dates from the flood file at runtime.
    const fileDates = datesFromFlood(floodData);
    if (fileDates.length > 0) {
      DATES = fileDates;
      applyDatesToSlider(DATES);
    } else if (DATES.length > 0) {
      applyDatesToSlider(DATES);
    }

    // Exposure file is { _meta, units: { <id>: {...} } }
    const exposureUnits: Record<string, unknown> | null =
      exposureData && typeof exposureData === "object" ? (exposureData.units ?? null) : null;

    let currentDate: string = DATES[0] ?? "";
    let playInterval: ReturnType<typeof setInterval> | null = null;


    // Opacity expressions keyed to the selected acquisition date. All dates
    // live in ONE source; only the per-feature opacity changes, and each
    // paint property has a transition, so stepping the slider cross-dissolves
    // the water (GPU-tweened) instead of swapping geometry and popping.
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    function op(date: string, active: number): any {
      return ["case", ["==", ["get", "date"], date], active, 0];
    }

    map.on("load", () => {
      // ---- CONTEXT layers first (bottom): they must never bury the flood ----
      // Hazard gap is analytical context, not a blanket. Only the civically
      // meaningful "under-observed prone" provinces get a visible fill; the
      // rest are a faint tint + thin outline so the flood reads on top.
      if (hazardData && hazardData.features && (hazardData.features as unknown[]).length > 0) {
        map.addSource("hazard-gap", { type: "geojson", data: hazardData });
        map.addLayer({
          id: "hazard-gap-fill",
          type: "fill",
          source: "hazard-gap",
          paint: {
            "fill-color": [
              "match", ["get", "gap"],
              "under_observed_prone", "#d1495b",
              "charted", "#5b7fa6",
              "monitored", "#8aa0bc",
              "#aab4c2",
            ],
            "fill-opacity": [
              "match", ["get", "gap"],
              "under_observed_prone", 0.42,
              "charted", 0.1,
              "monitored", 0.14,
              0.06,
            ],
          },
        });
        map.addLayer({
          id: "hazard-gap-line",
          type: "line",
          source: "hazard-gap",
          paint: { "line-color": "#3a4a63", "line-width": 0.5, "line-opacity": 0.35 },
        });
        map.on("click", "hazard-gap-fill", (e) => {
          const f = e.features?.[0];
          if (!f) return;
          // eslint-disable-next-line @typescript-eslint/no-explicit-any
          showCity(f.properties as Record<string, any>, exposureUnits as Record<string, any> | null);
        });
        map.on("mouseenter", "hazard-gap-fill", () => { map.getCanvas().style.cursor = "pointer"; });
        map.on("mouseleave", "hazard-gap-fill", () => { map.getCanvas().style.cursor = ""; });
      }

      // recurrence-dots is added lazily on first toggle (see below) so the
      // ~1.5 MB file is never fetched unless the user asks for it.

      // ---- FLOOD on TOP (the hero): vivid water, never buried ----
      map.addSource("flood", { type: "geojson", data: floodData ?? { type: "FeatureCollection", features: [] } });
      map.addLayer({
        id: "flood-glow",
        type: "fill",
        source: "flood",
        paint: {
          "fill-color": "#5ec8f5",
          "fill-opacity": op(currentDate, 0.35),
          "fill-antialias": true,
        },
      });
      map.addLayer({
        id: "flood-fill",
        type: "fill",
        source: "flood",
        paint: {
          "fill-color": "#1391d4",
          "fill-opacity": op(currentDate, 0.66),
          "fill-antialias": true,
        },
      });
      map.addLayer({
        id: "flood-line",
        type: "line",
        source: "flood",
        paint: {
          "line-color": "#063a63",
          "line-width": 1.1,
          "line-blur": 2.2,
          "line-opacity": op(currentDate, 0.6),
        },
      });
      // Paint transitions (runtime-valid in MapLibre; not in its paint TS type)
      map.setPaintProperty("flood-glow", "fill-opacity-transition", { duration: 700, delay: 0 });
      map.setPaintProperty("flood-fill", "fill-opacity-transition", { duration: 650, delay: 0 });
      map.setPaintProperty("flood-line", "line-opacity-transition", { duration: 650, delay: 0 });

      map.fitBounds([[120.5, 14.4], [121.4, 15.3]], { padding: 30, animate: false, maxZoom: 11 });
      // Dedicated Carina-view handle so QA can introspect the historical-demo
      // map deterministically. The global __fwMap/__fwReady contract belongs
      // to the default Now view (NowView sets it); both maps setting the
      // global raced, leaving __fwMap pointed at whichever loaded last.
      (window as unknown as Record<string, unknown>)["__fwCarinaMap"] = map;
      (window as unknown as Record<string, unknown>)["__fwMap"] = map;
      const loading = document.getElementById("map-loading");
      if (loading) loading.style.display = "none";
      // Readiness flag: true once basemap tiles + overlays have painted.
      // Used by the hero recorder / E2E checks to avoid capturing a blank map.
      map.once("idle", () => {
        (window as unknown as Record<string, unknown>)["__fwReady"] = true;
      });
    });

    // ---- slider logic --------------------------------------------------

    const slider = document.getElementById("date-slider") as HTMLInputElement | null;
    const dateDisplay = document.getElementById("slider-date-display");

    function setDate(idx: number): void {
      currentDate = DATES[idx] ?? "";
      if (dateDisplay) dateDisplay.textContent = currentDate;
      // Cross-fade: only the per-feature opacity changes; the paint
      // transitions tween old date out / new date in on the GPU.
      if (map.getLayer("flood-glow"))
        map.setPaintProperty("flood-glow", "fill-opacity", op(currentDate, 0.28));
      if (map.getLayer("flood-fill"))
        map.setPaintProperty("flood-fill", "fill-opacity", op(currentDate, 0.52));
      if (map.getLayer("flood-line"))
        map.setPaintProperty("flood-line", "line-opacity", op(currentDate, 0.5));
    }

    setDate(0);

    slider?.addEventListener("input", (e) => {
      setDate(Number((e.target as HTMLInputElement).value));
    });

    const playBtn = document.getElementById("play-btn") as HTMLButtonElement | null;
    playBtn?.addEventListener("click", () => {
      if (playInterval) {
        clearInterval(playInterval);
        playInterval = null;
        if (playBtn) playBtn.textContent = "play";
        return;
      }
      if (playBtn) playBtn.textContent = "pause";
      let idx = Number(slider?.value ?? 0);
      // Continuous loop: watch the flood grow -> peak -> recede, then repeat.
      // 1600 ms/step lets the 650 ms cross-fade finish and hold a beat.
      playInterval = setInterval(() => {
        idx = (idx + 1) % DATES.length;
        if (slider) slider.value = String(idx);
        setDate(idx);
      }, 1600);
    });

    // ---- layer toggles --------------------------------------------------

    document.getElementById("toggle-flood")?.addEventListener("change", (e) => {
      const vis = (e.target as HTMLInputElement).checked ? "visible" : "none";
      for (const id of ["flood-glow", "flood-fill", "flood-line"]) {
        if (map.getLayer(id)) map.setLayoutProperty(id, "visibility", vis);
      }
    });

    document.getElementById("toggle-gap")?.addEventListener("change", (e) => {
      const vis = (e.target as HTMLInputElement).checked ? "visible" : "none";
      if (map.getLayer("hazard-gap-fill")) map.setLayoutProperty("hazard-gap-fill", "visibility", vis);
      if (map.getLayer("hazard-gap-line")) map.setLayoutProperty("hazard-gap-line", "visibility", vis);
    });

    // Lazy: fetch and add the ~1.5 MB recurrence layer on first activation.
    let recurrenceLoading = false;
    document.getElementById("toggle-recurrence")?.addEventListener("change", async (e) => {
      const checked = (e.target as HTMLInputElement).checked;
      if (map.getLayer("recurrence-dots")) {
        map.setLayoutProperty("recurrence-dots", "visibility", checked ? "visible" : "none");
        return;
      }
      if (!checked || recurrenceLoading) return;
      recurrenceLoading = true;
      const recurrenceData = await safeFetch(`${DATA_BASE}/recurrence_prone.geojson`);
      recurrenceLoading = false;
      if (recurrenceData && recurrenceData.features && (recurrenceData.features as unknown[]).length > 0) {
        map.addSource("recurrence", { type: "geojson", data: recurrenceData });
        map.addLayer({
          id: "recurrence-dots",
          type: "circle",
          source: "recurrence",
          filter: ["==", ["get", "prone"], true],
          paint: {
            "circle-radius": ["interpolate", ["linear"], ["zoom"], 8, 2, 12, 4, 16, 6],
            "circle-color": "#d97757",
            "circle-opacity": 0.7,
            "circle-stroke-color": "#ffffff",
            "circle-stroke-width": 0.8,
          },
        });
      }
    });

    // ---- sidebar back button -------------------------------------------

    const emptyState = document.getElementById("empty-state");
    const cityDetail = document.getElementById("city-detail");

    document.getElementById("brgy-back")?.addEventListener("click", () => {
      cityDetail?.classList.add("hidden");
      emptyState?.classList.remove("hidden");
    });
  }

  function runInit(): void {
    init().catch((err: unknown) => {
      console.error("FloodWatch map init error:", err);
      const mapEl = document.getElementById("map");
      if (mapEl) {
        mapEl.innerHTML = '<div class="p-6 text-sm text-ink-500">Map data is loading. If this persists, check the browser console.</div>';
      }
    });
  }

  // PERF (audit): the Carina demo eager-loaded ~4.5 MB of GeoJSON on every
  // /map visit, even when the default view is the lightweight Now view. Defer
  // the whole init (and therefore every fetch) until the Carina panel is
  // actually shown. On the standalone /map (no panel wrapper) it runs at once.
  const carinaPanel = document.getElementById("panel-carina");
  let mapStarted = false;
  function maybeInitCarina(): void {
    if (mapStarted) return;
    // Visible when there is no panel wrapper, or the wrapper is not hidden.
    if (carinaPanel && carinaPanel.classList.contains("hidden")) return;
    mapStarted = true;
    runInit();
  }
  if (carinaPanel) {
    new MutationObserver(maybeInitCarina).observe(carinaPanel, {
      attributes: true,
      attributeFilter: ["class"],
    });
    maybeInitCarina();
  } else {
    runInit();
  }
</script>

