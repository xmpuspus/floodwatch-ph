---
// NowView -- the honest near-real-time surface.
//
// Renders the three new realtime layers from the pipeline, each as-of-dated
// from its own _meta (never hardcoded):
//   1. flood_latest.geojson      -- observed Sentinel-1 SAR, the HERO layer
//   2. road_flood_exposure       -- expressway segments by exposure
//   3. current_risk.geojson      -- GPM IMERG rainfall CONTEXT (not forecast)
//
// Locked z-order: context (rainfall) first, then roads, then the observed
// flood extent LAST so the hero layer is never buried.
//
// Honest empty states are mandatory: when scan_status != "ok" we show the
// real reason and the last good as_of, never a blank map read as "no flood".
// When 0 expressways intersect water we say so plainly. We never fake water.
//
// PERF: this component fetches NOTHING at import. init() runs only when the
// Now view is activated (the parent toggles [data-now-active]); the realtime
// files are not on the default /map path.
---

<div id="now-root" data-now-active="false">
  <!-- Expressway callout: the motivating civic question, answered honestly. -->
  <section class="max-w-6xl mx-auto px-6 mb-4">
    <div class="border border-ink-300/40 bg-white">
      <div class="px-5 py-4 border-b border-ink-300/30">
        <p class="text-[10px] uppercase tracking-wider text-ink-500 font-mono mb-1">
          monitored expressways, latest observed Sentinel-1 pass
        </p>
        <h2 class="text-xl text-ink-900 leading-tight">
          Did the latest satellite pass see water on the expressways?
        </h2>
        <p id="now-expressway-line" class="text-sm text-ink-700 mt-1.5 leading-relaxed">
          Checking the most recent observed pass...
        </p>
      </div>
      <div
        id="now-expressway-grid"
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-px bg-ink-300/30"
      >
      </div>
      <p class="px-5 py-3 text-[12px] text-ink-500 leading-relaxed">
        Observed, lagged by the Sentinel-1 revisit (~6 to 12 days). Not a
        forecast and not a routing instruction. For live road conditions use
        MMDA Flood Control, PAGASA, and your LGU DRRMO. Want to check a
        specific place or corridor?
        <a href="/lookup" class="no-underline text-accent-steel">Use the evidence lookup</a>.
      </p>
    </div>
  </section>

  <!-- Layer toggles -->
  <section class="max-w-6xl mx-auto px-6 mb-3">
    <div class="bg-paper border border-ink-300/30 p-4">
      <p class="text-[10px] uppercase tracking-wider text-ink-500 font-mono mb-2">
        now view layers
      </p>
      <div class="flex flex-wrap gap-4 text-xs">
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input id="now-toggle-flood" type="checkbox" checked class="accent-accent-flood" />
          <span class="text-ink-700">Observed flood extent (latest pass)</span>
        </label>
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input id="now-toggle-roads" type="checkbox" checked class="accent-ink-700" />
          <span class="text-ink-700">Monitored expressways</span>
        </label>
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input id="now-toggle-rain" type="checkbox" class="accent-accent-coral" />
          <span class="text-ink-700">Rainfall context (GPM IMERG)</span>
        </label>
      </div>
    </div>
  </section>

  <!-- Honest status strip for the observed pass itself -->
  <section class="max-w-6xl mx-auto px-6 mb-3">
    <div
      id="now-scan-status"
      class="border-l-4 border-ink-300/50 bg-paper-alt px-4 py-3 text-sm text-ink-900 leading-relaxed"
      role="status"
      aria-live="polite"
    >
      Loading the most recent observed Sentinel-1 pass...
    </div>
  </section>

  <div class="grid md:grid-cols-[1fr_340px] gap-4 px-6 max-w-6xl mx-auto">
    <div class="relative">
      <div id="now-map" class="w-full h-[600px] rounded-md border border-ink-300/30 bg-ink-300/10">
        <div id="now-map-loading" class="absolute inset-0 flex items-center justify-center text-sm text-ink-500">
          Now view loads when you open it.
        </div>
      </div>

      <!-- Legend (Tufte: direct, defined, standalone) -->
      <div class="absolute bottom-3 left-3 bg-white/95 border border-ink-300/40 rounded p-3 text-xs shadow-sm max-w-[230px]">
        <div class="text-ink-500 uppercase tracking-wider text-[10px] mb-1 font-mono">observed flood (SAR)</div>
        <div class="grid grid-cols-[auto_1fr] items-center gap-x-2 gap-y-0.5 text-[10px] text-ink-700 mb-2">
          <span class="inline-block w-3 h-3 rounded-sm" style="background:#1391d4;opacity:0.66"></span><span>open water, latest pass</span>
        </div>
        <div class="text-ink-500 uppercase tracking-wider text-[10px] mb-1 font-mono">expressways</div>
        <div class="grid grid-cols-[auto_1fr] items-center gap-x-2 gap-y-0.5 text-[10px] text-ink-700 mb-2">
          <span class="inline-block w-3 h-1.5 rounded-sm" style="background:#a8431e"></span><span>flooded</span>
          <span class="inline-block w-3 h-1.5 rounded-sm" style="background:#d97757"></span><span>near water (30 m)</span>
          <span class="inline-block w-3 h-1.5 rounded-sm" style="background:#3a6ea5"></span><span>no overlap this pass</span>
          <span class="inline-block w-3 h-1.5 rounded-sm" style="background:#8e98ac"></span><span>pass not usable</span>
        </div>
        <div class="text-ink-500 uppercase tracking-wider text-[10px] mb-1 font-mono">rainfall context (24 h)</div>
        <div class="grid grid-cols-[auto_1fr] items-center gap-x-2 gap-y-0.5 text-[10px] text-ink-700">
          <span class="inline-block w-3 h-3 rounded-full" style="background:#c0392b"></span><span>red, &ge;120 mm/24h</span>
          <span class="inline-block w-3 h-3 rounded-full" style="background:#d97757"></span><span>orange, &ge;60 mm/24h</span>
          <span class="inline-block w-3 h-3 rounded-full" style="background:#e3b341"></span><span>yellow, &ge;30 mm/24h</span>
        </div>
        <p class="text-[9px] text-ink-500 mt-2 leading-snug">
          Rainfall labels are PAGASA advisory colours mapped onto GPM IMERG
          24 h accumulation (already-fallen rain). Context only, not a PAGASA
          product and not a flood forecast.
        </p>
      </div>

      <div class="absolute bottom-1 right-2 bg-white/85 px-1.5 py-0.5 text-[9px] text-ink-500 rounded-sm border border-ink-300/30 leading-tight">
        &copy; OpenStreetMap contributors. SAR: Copernicus/Sentinel-1. Rain: NASA GPM IMERG.
      </div>
    </div>

    <!-- Sidebar: source provenance + as-of dates, all dynamic -->
    <aside class="border border-ink-300/40 bg-white text-sm p-5">
      <p class="text-xs uppercase tracking-wider text-ink-500 font-mono mb-2">what the now view is</p>
      <p class="text-ink-700 leading-relaxed text-[13px]">
        The most recent OBSERVED Sentinel-1 SAR pass over Greater Metro Manila
        and the SLEX/NLEX corridor, the expressway network intersected with it,
        and GPM IMERG rainfall accumulation over modeled flood-prone areas as
        context to bridge the satellite revisit gap. Every layer is as-of-dated
        below. Nothing here is live and nothing here is a forecast.
      </p>
      <dl class="mt-4 space-y-2 text-[12px]">
        <div class="flex justify-between gap-3 border-t border-ink-300/30 pt-2">
          <dt class="text-ink-500">Observed SAR pass</dt>
          <dd id="now-asof-sar" class="font-mono text-ink-900 text-right">--</dd>
        </div>
        <div class="flex justify-between gap-3 border-t border-ink-300/30 pt-2">
          <dt class="text-ink-500">Expressway join</dt>
          <dd id="now-asof-roads" class="font-mono text-ink-900 text-right">--</dd>
        </div>
        <div class="flex justify-between gap-3 border-t border-ink-300/30 pt-2">
          <dt class="text-ink-500">Rainfall context</dt>
          <dd id="now-asof-rain" class="font-mono text-ink-900 text-right">--</dd>
        </div>
      </dl>
      <p class="text-[11px] text-ink-500 italic mt-4 leading-relaxed">
        Observed flood extent derived from public satellite data. Patterns may
        have legitimate explanations; figures warrant independent verification.
      </p>
    </aside>
  </div>
</div>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";

  const $ = (id: string) => document.getElementById(id);
  const DATA = "/data";

  async function getJSON(url: string): Promise<any | null> {
    try {
      const r = await fetch(url);
      if (!r.ok) return null;
      return await r.json();
    } catch {
      return null;
    }
  }

  let started = false;
  let map: any = null;

  function scanReason(meta: any): string {
    const note = meta?.note;
    if (typeof note === "string" && note) return note;
    const s = meta?.scan_status;
    if (s === "degenerate_threshold") return "no reliable water/land separation in the Otsu valley";
    if (s === "low_confidence") return "detected area exceeded the plausibility cap (likely speckle, not flood)";
    if (s === "no_usable_pass") return "no Sentinel-1 acquisition with enough area coverage in the lookback window";
    return "the satellite pass was not usable";
  }

  function expresswayCard(name: string, s: any): string {
    const flooded = s?.flooded ?? 0;
    const near = s?.near ?? 0;
    const unknown = s?.unknown ?? 0;
    let label: string;
    let cls: string;
    if (unknown > 0 && flooded === 0 && near === 0) {
      label = "pass not usable";
      cls = "text-ink-500";
    } else if (flooded > 0) {
      label = `${flooded} segment${flooded === 1 ? "" : "s"} flooded`;
      cls = "text-accent-coral-dark font-semibold";
    } else if (near > 0) {
      label = `${near} near water`;
      cls = "text-accent-coral";
    } else {
      label = "no overlap this pass";
      cls = "text-ink-700";
    }
    return `<div class="bg-white p-3">
      <div class="text-[11px] font-mono uppercase tracking-wider text-ink-900">${name}</div>
      <div class="text-[12px] mt-1 ${cls}">${label}</div>
    </div>`;
  }

  async function init(): Promise<void> {
    const loadingEl = $("now-map-loading");

    // Parallel lazy load -- only happens once the Now view is opened.
    const [flood, roads, rain] = await Promise.all([
      getJSON(`${DATA}/flood_latest.geojson`),
      getJSON(`${DATA}/road_flood_exposure.geojson`),
      getJSON(`${DATA}/current_risk.geojson`),
    ]);

    const fMeta = flood?._meta ?? null;
    const rdMeta = roads?._meta ?? null;
    const rnMeta = rain?._meta ?? null;

    // ---- as-of dates, all dynamic ----
    const sarAsOf = fMeta?.as_of ?? null;
    const sarStatus = fMeta?.scan_status ?? "unknown";
    if ($("now-asof-sar"))
      $("now-asof-sar")!.textContent = sarAsOf
        ? `${sarAsOf}${sarStatus === "ok" ? "" : " (withheld)"}`
        : "no usable pass";
    if ($("now-asof-roads"))
      $("now-asof-roads")!.textContent = rdMeta?.as_of ?? "no usable pass";
    if ($("now-asof-rain"))
      $("now-asof-rain")!.textContent = rnMeta?.as_of ?? "unavailable";

    // ---- honest scan-status strip for the observed pass ----
    const statusEl = $("now-scan-status");
    if (statusEl) {
      if (sarStatus === "ok" && Array.isArray(flood?.features) && flood.features.length > 0) {
        statusEl.textContent =
          `Showing the observed Sentinel-1 SAR flood extent from the ${sarAsOf} pass ` +
          `(${fMeta?.feature_count ?? flood.features.length} polygons). ` +
          "This is the most recent observed pass, not live and not a forecast.";
        statusEl.className =
          "border-l-4 border-accent-flood bg-paper-alt px-4 py-3 text-sm text-ink-900 leading-relaxed";
      } else if (sarStatus === "no_usable_pass") {
        statusEl.textContent =
          "The most recent Sentinel-1 pass over Metro Manila was not usable: " +
          `${scanReason(fMeta)}. No observed extent is shown. This is not a clear-conditions signal.`;
        statusEl.className =
          "border-l-4 border-accent-coral-dark bg-paper-alt px-4 py-3 text-sm text-ink-900 leading-relaxed";
      } else {
        statusEl.textContent =
          `The last Sentinel-1 pass${sarAsOf ? ` (${sarAsOf})` : ""} was not usable: ` +
          `${scanReason(fMeta)}. No observed extent is shown. This is not a clear-conditions signal.`;
        statusEl.className =
          "border-l-4 border-accent-coral-dark bg-paper-alt px-4 py-3 text-sm text-ink-900 leading-relaxed";
      }
    }

    // ---- expressway callout (the motivating question) ----
    const exLine = $("now-expressway-line");
    const exGrid = $("now-expressway-grid");
    const summary = rdMeta?.expressway_summary ?? {};
    const names = Object.keys(summary);
    let totalFlooded = 0;
    let totalUnknown = 0;
    for (const n of names) {
      totalFlooded += summary[n]?.flooded ?? 0;
      totalUnknown += summary[n]?.unknown ?? 0;
    }
    if (exLine) {
      if (sarStatus !== "ok") {
        exLine.textContent =
          "The most recent Sentinel-1 pass was not usable, so expressway " +
          "exposure could not be computed for this window. This is not a " +
          "clear-conditions signal. Use MMDA Flood Control and PAGASA for live road conditions.";
      } else if (totalFlooded === 0) {
        exLine.innerHTML =
          `No monitored expressway segments intersect the most recent observed ` +
          `flood extent (as of ${rdMeta?.as_of ?? sarAsOf}). This is the truthful ` +
          `current state of the latest pass, not an all-clear: the satellite ` +
          `revisit is ~6 to 12 days and conditions change between passes.`;
      } else {
        exLine.innerHTML =
          `${totalFlooded} monitored expressway segment${totalFlooded === 1 ? "" : "s"} ` +
          `intersected observed water on the ${rdMeta?.as_of ?? sarAsOf} pass. ` +
          `Observed, not a forecast or routing instruction.`;
      }
    }
    if (exGrid) {
      // Stable, named order: the corridors that matter for the SLEX/NLEX case.
      const order = ["SLEX", "NLEX", "Skyway", "CAVITEX", "NAIAX", "CALAX", "SCTEX", "TPLEX", "C5", "EDSA", "Commonwealth Ave"];
      const ordered = order.filter((n) => n in summary).concat(names.filter((n) => !order.includes(n)));
      exGrid.innerHTML = ordered.map((n) => expresswayCard(n, summary[n])).join("");
    }

    // ---- map ----
    map = new maplibregl.Map({
      container: "now-map",
      style: {
        version: 8,
        sources: {
          osm: {
            type: "raster",
            tiles: [
              "https://a.tile.openstreetmap.org/{z}/{x}/{y}.png",
              "https://b.tile.openstreetmap.org/{z}/{x}/{y}.png",
              "https://c.tile.openstreetmap.org/{z}/{x}/{y}.png",
            ],
            tileSize: 256,
            attribution: "&copy; OpenStreetMap contributors",
          },
        },
        layers: [{ id: "osm", type: "raster", source: "osm" }],
      },
      center: [120.98, 14.6] as [number, number],
      zoom: 8.4,
    });
    map.addControl(new maplibregl.NavigationControl(), "top-right");

    map.on("load", () => {
      if (loadingEl) loadingEl.style.display = "none";

      // ---- CONTEXT first (bottom): rainfall, subtle so it never buries water ----
      if (rain && Array.isArray(rain.features) && rain.features.length > 0) {
        map.addSource("now-rain", { type: "geojson", data: rain });
        map.addLayer({
          id: "now-rain-dots",
          type: "circle",
          source: "now-rain",
          layout: { visibility: "none" },
          filter: ["!=", ["get", "context_flag"], "none"],
          paint: {
            "circle-radius": ["interpolate", ["linear"], ["zoom"], 7, 2.5, 11, 5],
            "circle-color": [
              "match",
              ["get", "context_flag"],
              "red", "#c0392b",
              "orange", "#d97757",
              "yellow", "#e3b341",
              "#e3b341",
            ],
            "circle-opacity": 0.55,
            "circle-stroke-color": "#ffffff",
            "circle-stroke-width": 0.5,
          },
        });
      }

      // ---- ROADS in the middle ----
      if (roads && Array.isArray(roads.features) && roads.features.length > 0) {
        map.addSource("now-roads", { type: "geojson", data: roads });
        map.addLayer({
          id: "now-roads-line",
          type: "line",
          source: "now-roads",
          paint: {
            "line-color": [
              "match",
              ["get", "exposure"],
              "flooded", "#a8431e",
              "near", "#d97757",
              "clear", "#3a6ea5",
              "#8e98ac",
            ],
            "line-width": [
              "match",
              ["get", "exposure"],
              "flooded", 3.0,
              "near", 2.2,
              1.0,
            ],
            "line-opacity": [
              "match",
              ["get", "exposure"],
              "clear", 0.35,
              "unknown", 0.3,
              0.9,
            ],
          },
        });
        map.on("click", "now-roads-line", (e: any) => {
          const f = e.features?.[0];
          if (!f) return;
          const p = f.properties || {};
          new maplibregl.Popup({ closeButton: true })
            .setLngLat(e.lngLat)
            .setHTML(
              `<div style="padding:8px 10px;font-size:12px;max-width:220px">
                 <strong>${p.road_name || "Road"}</strong><br/>
                 exposure: ${p.exposure || "unknown"}<br/>
                 ${
                   p.exposure === "flooded"
                     ? `${Number(p.flooded_length_m || 0).toFixed(0)} m under observed water`
                     : "observed, not a forecast"
                 }
               </div>`,
            )
            .addTo(map);
        });
        map.on("mouseenter", "now-roads-line", () => { map.getCanvas().style.cursor = "pointer"; });
        map.on("mouseleave", "now-roads-line", () => { map.getCanvas().style.cursor = ""; });
      }

      // ---- OBSERVED FLOOD on TOP (the hero), only when honestly present ----
      const hasFlood =
        sarStatus === "ok" && Array.isArray(flood?.features) && flood.features.length > 0;
      map.addSource("now-flood", {
        type: "geojson",
        data: hasFlood ? flood : { type: "FeatureCollection", features: [] },
      });
      map.addLayer({
        id: "now-flood-fill",
        type: "fill",
        source: "now-flood",
        paint: { "fill-color": "#1391d4", "fill-opacity": 0.6, "fill-antialias": true },
      });
      map.addLayer({
        id: "now-flood-line",
        type: "line",
        source: "now-flood",
        paint: { "line-color": "#063a63", "line-width": 1.1, "line-opacity": 0.7 },
      });

      map.fitBounds([[120.4, 14.0], [121.55, 15.4]], { padding: 24, animate: false, maxZoom: 10 });
      (window as any).__fwNowReady = true;
    });

    // ---- toggles ----
    $("now-toggle-flood")?.addEventListener("change", (e) => {
      const vis = (e.target as HTMLInputElement).checked ? "visible" : "none";
      for (const id of ["now-flood-fill", "now-flood-line"])
        if (map.getLayer(id)) map.setLayoutProperty(id, "visibility", vis);
    });
    $("now-toggle-roads")?.addEventListener("change", (e) => {
      const vis = (e.target as HTMLInputElement).checked ? "visible" : "none";
      if (map.getLayer("now-roads-line")) map.setLayoutProperty("now-roads-line", "visibility", vis);
    });
    $("now-toggle-rain")?.addEventListener("change", (e) => {
      const vis = (e.target as HTMLInputElement).checked ? "visible" : "none";
      if (map.getLayer("now-rain-dots")) map.setLayoutProperty("now-rain-dots", "visibility", vis);
    });
  }

  // Lazy activation: the parent map page flips data-now-active to "true" the
  // first time the Now tab is opened. We only fetch + build then. Resize the
  // map when it becomes visible (MapLibre needs a kick after display:none).
  function maybeStart(): void {
    const root = $("now-root");
    if (!root) return;
    if (root.getAttribute("data-now-active") !== "true") return;
    if (!started) {
      started = true;
      init().catch((err) => {
        console.error("FloodWatch Now view init error:", err);
        const el = $("now-map");
        if (el)
          el.innerHTML =
            '<div class="p-6 text-sm text-ink-500">Could not load the Now view data. No query was sent anywhere.</div>';
      });
    } else if (map) {
      setTimeout(() => map.resize(), 60);
    }
  }

  const rootEl = $("now-root");
  if (rootEl) {
    new MutationObserver(maybeStart).observe(rootEl, {
      attributes: true,
      attributeFilter: ["data-now-active"],
    });
    maybeStart();
  }
</script>
